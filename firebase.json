{
  "//": "수락스트릿 — 프론트는 GitHub Pages(surakstreet.com), 백엔드+스테이징은 Firebase.",
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "functions/**", "**/node_modules/**", "firestore.rules", "firestore.indexes.json", "*.md", "CNAME"],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(html|css|js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      },
      {
        "source": "/admin",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
